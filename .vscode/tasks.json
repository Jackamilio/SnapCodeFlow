{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "windows": {
                "command": "mingw32-make"
            },
            "linux": {
                "command": "make"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "windows": {
                "command": "mingw32-make",
                "args": ["clean"]
            },
            "linux": {
                "command": "make",
                "args": ["clean"]
            },
            "problemMatcher": []
        }
    ]
}